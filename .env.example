PORT=3000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=1

AZURE_DEVOPS_ORG=https://dev.azure.com/your_org
AZURE_DEVOPS_PAT=your_azure_devops_pat_here

# Webhook'un kabul ettiği Basic Auth
WEBHOOK_USER=your_basic_auth_user
WEBHOOK_PASSWORD=your_basic_auth_password

# Tekrar eden istekleri engelleme süreleri (saniye)
WEBHOOK_DUPLICATE_WINDOW_SECONDS=30
WEBHOOK_COOLDOWN_SECONDS=60

# Only work items in this state trigger a pipeline. Defaults to "To Do"
# (Boards Management). Use "New" for Agile, "Approved" for Scrum, etc.
WEBHOOK_TRIGGER_STATE=To Do

# Tag prefix for triggering. Default: ai-agent
#   <prefix>:<repo>           triggers pipeline for that repo
#   <prefix>-model:<model>    overrides Claude model (sonnet/opus/haiku)
#   <prefix>-turns:<N>        overrides max turns (N * 10)
AI_AGENT_TAG_PREFIX=ai-agent

# UI language for response messages. Supported: en, tr. Default: en
AI_AGENT_LANG=en
